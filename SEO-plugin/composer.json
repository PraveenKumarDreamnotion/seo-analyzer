{
    "name": "thrivemattic/seo-analyzer",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.0",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "mpdf/mpdf": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": { "HaloAudit\\": "includes/engine/" }
    },
    "autoload-dev": {
        "psr-4": { "HaloAudit\\Tests\\": "tests/unit/" }
    },
    "config": {
        "platform": { "php": "8.0.30" }
    },
    "scripts": {
        "test": "phpunit"
    }
}
